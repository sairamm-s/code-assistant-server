generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Repository {
  id           String   @id @default(cuid())
  source       String
  sourceUrl    String?
  name         String
  status       String   @default("queued")
  jobId        String?
  fileCount    Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@map("repositories")
}

// Remaining models (CodeChunk, RepositoryOverview, ChatMessage) added by later /feature runs per docs/PLAN.md Section 3
