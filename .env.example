PORT=5000
NODE_ENV=development

# PostgreSQL (with pgvector extension enabled)
DATABASE_URL=postgresql://postgres:password@localhost:5432/code_doc_assistant

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Ingestion queue tuning (all optional — defaults shown)
INGESTION_JOB_ATTEMPTS=3
INGESTION_JOB_BACKOFF_MS=5000
INGESTION_WORKER_CONCURRENCY=3
