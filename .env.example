PORT=5050
NODE_ENV=development

# PostgreSQL (with pgvector extension enabled)
DATABASE_URL=postgresql://postgres:password@localhost:5432/code_doc_assistant

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Google Gemini (embeddings only — see GENERATION_PROVIDER below for chat/overview generation)
GEMINI_API_KEY=your_gemini_api_key

# Groq (chat/overview generation) — free tier, no billing card required.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Ingestion queue tuning (all optional — defaults shown)
INGESTION_JOB_ATTEMPTS=3
INGESTION_JOB_BACKOFF_MS=5000
INGESTION_WORKER_CONCURRENCY=3

# Chunking/embedding tuning (all optional — defaults shown)
# 200/40 keeps a full ingestion at ~5 embedding requests, under Gemini's
# free-tier cap of 100 embed_content requests/minute.
MAX_CHUNKS_PER_REPOSITORY=200
EMBEDDING_BATCH_SIZE=40
EMBEDDING_MODEL_NAME=gemini-embedding-001
# Set to false to skip chunking/embedding and rely on the repository overview only
ENABLE_CHUNKING_EMBEDDING=true

# Repository overview / chat generation tuning (all optional — defaults shown)
GENERATION_PROVIDER=groq
GENERATION_MODEL_NAME=llama-3.3-70b-versatile
MAX_KEY_FILES_FOR_OVERVIEW=8
MAX_KEY_FILE_CHARS=2000
